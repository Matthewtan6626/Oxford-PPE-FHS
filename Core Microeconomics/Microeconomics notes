\noindent\textbf{Brouwer's Fixed Point Theorem:} For any continuous function $f$ mapping a nonempty convex set to itself, there exists a point $x_0$ such that $f(x_0) = x_0$. \\
\textbf{Applications:} Game Theory, General Equilibrium. \\

\noindent\textbf{Kakutani Fixed point theorem:} Let $S$ be a nonempty, compact and convex subset of the Euclidean space $\mathbb{R}^n$. Let $\phi: S \rightarrow 2^S$ be a set-valued function on S with the following properties: \begin{itemize}
    \item $\phi$ has a closed graph
    \item $\phi(x)$ is nonempty and convex for all $x\in S$
\end{itemize} 
Then $\phi$ has a fixed point.\\
\textbf{Applications:} General Equilibrium. \\

\noindent\textbf{Hyperplane Separation Theorem:} Let $A$ and $B$ be two disjoint nonempty convex subsets of $\mathbb{R}^n$. Then there exists a nonzero vector $v$ and a real number $c$ such that \begin{equation*}
    \langle x,v \rangle \ge c \hspace{0.2cm} \text{and} \hspace{0.2cm} \langle y,v \rangle \le c
\end{equation*}
for all $x$ in $A$ and $y$ in $B$ i.e. the hyperplane $\langle \cdot, v \rangle = c$ with the normal vector $v$ separates $A$ and $B$. \\

\noindent If both sets are closed, then the separation can be strict, such that \begin{equation*}
    \langle x,v \rangle > c_1 \hspace{0.2cm} \text{and} \hspace{0.2cm} \langle y,v \rangle < c_2
\end{equation*} where $c_1>c_2$. \\
\textbf{Applications:} Second Fundamental Welfare Theorem. 



